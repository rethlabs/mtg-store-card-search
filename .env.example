# TCGplayer no longer grants new API access. These values must come from an
# existing TCGplayer developer account. Never commit real credentials.
TCGPLAYER_PUBLIC_KEY=replace_me
TCGPLAYER_PRIVATE_KEY=replace_me

# Optional. Only needed when a specific TCGplayer store has authorized your app.
# TCGPLAYER_ACCESS_TOKEN=replace_me

# Optional overrides.
# TCGPLAYER_API_BASE=https://api.tcgplayer.com/v1.39.0
# TCGPLAYER_TOKEN_URL=https://api.tcgplayer.com/token

